# Third-party OOXML schemas (ECMA-376 / ISO-IEC 29500 XSDs) vendored with the
# docx/pptx default skills. Excluded from language stats.
#
# Rules are scoped to asset extensions only. Never mark JSON, Markdown, or
# script files vendored/generated: plugin hooks, skills, and MCP configs must
# stay visible in PR diffs (validate-catalog.py rejects local plugin sources
# containing files with these attributes).
default-skills/*/scripts/office/schemas/**/*.xsd linguist-vendored

# Pre-built PPTX design templates. Binary assets, not meant for line-by-line review.
default-skills/pptx/templates/**/*.pptx linguist-vendored
